{
  "$defs": {
    "ArtifactEntry": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "title": "ArtifactEntry",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "traceback": {
          "default": "",
          "title": "Traceback",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    }
  },
  "$id": "https://cellquant.local/hpc/v1/task_result.schema.json",
  "additionalProperties": false,
  "description": "The record of one acquisition's attempt. For a success it is written last, after its artifacts.",
  "properties": {
    "acquisition_id": {
      "title": "Acquisition Id",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactEntry"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "bundle_id": {
      "title": "Bundle Id",
      "type": "string"
    },
    "device": {
      "default": "",
      "title": "Device",
      "type": "string"
    },
    "ended_at": {
      "title": "Ended At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "qc": {
      "additionalProperties": true,
      "title": "Qc",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "runtime_fingerprint": {
      "title": "Runtime Fingerprint",
      "type": "string"
    },
    "runtime_sha256": {
      "title": "Runtime Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "task_key": {
      "title": "Task Key",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "bundle_id",
    "run_id",
    "acquisition_id",
    "task_key",
    "attempt_id",
    "outcome",
    "started_at",
    "ended_at",
    "runtime_fingerprint",
    "runtime_sha256"
  ],
  "title": "TaskResult",
  "type": "object"
}
