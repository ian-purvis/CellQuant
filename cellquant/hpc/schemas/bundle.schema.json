{
  "$defs": {
    "Acquisition": {
      "additionalProperties": false,
      "description": "One prepared image: where it came from, its exported copy, and how it will be analyzed.",
      "properties": {
        "acquisition_id": {
          "title": "Acquisition Id",
          "type": "string"
        },
        "calibration_source": {
          "enum": [
            "file",
            "user",
            "file_and_user",
            "missing"
          ],
          "title": "Calibration Source",
          "type": "string"
        },
        "channel_colors": {
          "items": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Channel Colors",
          "type": "array"
        },
        "channel_layout_confirmed": {
          "default": false,
          "title": "Channel Layout Confirmed",
          "type": "boolean"
        },
        "channel_names": {
          "items": {
            "type": "string"
          },
          "title": "Channel Names",
          "type": "array"
        },
        "dtype": {
          "title": "Dtype",
          "type": "string"
        },
        "effective_spacing_xyz_um": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Effective Spacing Xyz Um",
          "type": "array"
        },
        "effective_z_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Z Index"
        },
        "effective_z_mode": {
          "enum": [
            "none",
            "max_projection",
            "single_plane",
            "stitch_slices",
            "full_3d"
          ],
          "title": "Effective Z Mode",
          "type": "string"
        },
        "file_spacing_xyz_um": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "File Spacing Xyz Um",
          "type": "array"
        },
        "input_file_sha256": {
          "title": "Input File Sha256",
          "type": "string"
        },
        "input_path": {
          "title": "Input Path",
          "type": "string"
        },
        "objective": {
          "default": "",
          "title": "Objective",
          "type": "string"
        },
        "pixel_sha256": {
          "title": "Pixel Sha256",
          "type": "string"
        },
        "sample_name": {
          "title": "Sample Name",
          "type": "string"
        },
        "shape_czyx": {
          "items": {
            "type": "integer"
          },
          "title": "Shape Czyx",
          "type": "array"
        },
        "source_file_sha256": {
          "title": "Source File Sha256",
          "type": "string"
        },
        "source_image_id": {
          "title": "Source Image Id",
          "type": "string"
        },
        "source_position": {
          "minimum": 0,
          "title": "Source Position",
          "type": "integer"
        },
        "source_relative_path": {
          "title": "Source Relative Path",
          "type": "string"
        },
        "task_key": {
          "title": "Task Key",
          "type": "string"
        },
        "user_metadata": {
          "additionalProperties": true,
          "title": "User Metadata",
          "type": "object"
        }
      },
      "required": [
        "acquisition_id",
        "source_image_id",
        "source_relative_path",
        "source_file_sha256",
        "source_position",
        "sample_name",
        "input_path",
        "input_file_sha256",
        "pixel_sha256",
        "shape_czyx",
        "dtype",
        "channel_names",
        "file_spacing_xyz_um",
        "effective_spacing_xyz_um",
        "calibration_source",
        "effective_z_mode",
        "task_key"
      ],
      "title": "Acquisition",
      "type": "object"
    }
  },
  "$id": "https://cellquant.local/hpc/v1/bundle.schema.json",
  "additionalProperties": false,
  "properties": {
    "acquisitions": {
      "items": {
        "$ref": "#/$defs/Acquisition"
      },
      "minItems": 1,
      "title": "Acquisitions",
      "type": "array"
    },
    "application_build_sha256": {
      "title": "Application Build Sha256",
      "type": "string"
    },
    "bundle_id": {
      "title": "Bundle Id",
      "type": "string"
    },
    "cellquant_version": {
      "title": "Cellquant Version",
      "type": "string"
    },
    "channel_layout": {
      "items": {
        "type": "string"
      },
      "title": "Channel Layout",
      "type": "array"
    },
    "channel_layout_confirmed": {
      "default": false,
      "title": "Channel Layout Confirmed",
      "type": "boolean"
    },
    "cluster_path": {
      "const": "cluster.json",
      "default": "cluster.json",
      "title": "Cluster Path",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "kind": {
      "const": "cellquant_v2_hpc",
      "default": "cellquant_v2_hpc",
      "title": "Kind",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "package_name": {
      "title": "Package Name",
      "type": "string"
    },
    "recipe_path": {
      "const": "recipe.yaml",
      "default": "recipe.yaml",
      "title": "Recipe Path",
      "type": "string"
    },
    "recipe_scientific_sha256": {
      "title": "Recipe Scientific Sha256",
      "type": "string"
    },
    "runtime_path": {
      "const": "runtime.json",
      "default": "runtime.json",
      "title": "Runtime Path",
      "type": "string"
    },
    "runtime_sha256": {
      "title": "Runtime Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_experiment_id": {
      "title": "Source Experiment Id",
      "type": "string"
    },
    "source_experiment_name": {
      "title": "Source Experiment Name",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "package_name",
    "created_at",
    "cellquant_version",
    "application_build_sha256",
    "source_experiment_id",
    "source_experiment_name",
    "recipe_scientific_sha256",
    "runtime_sha256",
    "channel_layout",
    "acquisitions"
  ],
  "title": "BundleManifest",
  "type": "object"
}
