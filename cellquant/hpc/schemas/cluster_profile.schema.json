{
  "$id": "https://cellquant.local/hpc/v1/cluster_profile.schema.json",
  "additionalProperties": false,
  "description": "Where and with what resources a package runs. Structured fields only: no shell snippets.",
  "properties": {
    "account": {
      "title": "Account",
      "type": "string"
    },
    "cpus": {
      "maximum": 256,
      "minimum": 1,
      "title": "Cpus",
      "type": "integer"
    },
    "display_name": {
      "default": "",
      "title": "Display Name",
      "type": "string"
    },
    "gpu_resource": {
      "title": "Gpu Resource",
      "type": "string"
    },
    "gpus": {
      "const": 1,
      "default": 1,
      "title": "Gpus",
      "type": "integer"
    },
    "host": {
      "title": "Host",
      "type": "string"
    },
    "live_smoke_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Live Smoke Date"
    },
    "memory_mib": {
      "minimum": 512,
      "title": "Memory Mib",
      "type": "integer"
    },
    "modules": {
      "items": {
        "type": "string"
      },
      "title": "Modules",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "partition": {
      "title": "Partition",
      "type": "string"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "profile_verified_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Verified Date"
    },
    "python_path": {
      "title": "Python Path",
      "type": "string"
    },
    "qos": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qos"
    },
    "remote_durable_root": {
      "title": "Remote Durable Root",
      "type": "string"
    },
    "runtime_contract_path": {
      "title": "Runtime Contract Path",
      "type": "string"
    },
    "runtime_id": {
      "title": "Runtime Id",
      "type": "string"
    },
    "runtime_sha256": {
      "title": "Runtime Sha256",
      "type": "string"
    },
    "scheduler": {
      "const": "slurm",
      "default": "slurm",
      "title": "Scheduler",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scratch_root": {
      "title": "Scratch Root",
      "type": "string"
    },
    "validation_status": {
      "default": "draft",
      "enum": [
        "draft",
        "experimental",
        "production"
      ],
      "title": "Validation Status",
      "type": "string"
    },
    "walltime_seconds": {
      "maximum": 1209600,
      "minimum": 60,
      "title": "Walltime Seconds",
      "type": "integer"
    }
  },
  "required": [
    "profile_id",
    "host",
    "account",
    "partition",
    "gpu_resource",
    "cpus",
    "memory_mib",
    "walltime_seconds",
    "remote_durable_root",
    "scratch_root",
    "python_path",
    "runtime_id",
    "runtime_contract_path",
    "runtime_sha256"
  ],
  "title": "ClusterProfile",
  "type": "object"
}
