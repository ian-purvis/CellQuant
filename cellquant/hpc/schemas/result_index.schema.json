{
  "$defs": {
    "AcquisitionState": {
      "additionalProperties": false,
      "properties": {
        "acquisition_id": {
          "title": "Acquisition Id",
          "type": "string"
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Id"
        },
        "commit_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Path"
        },
        "commit_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha256"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "state": {
          "default": "pending",
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "acquisition_id"
      ],
      "title": "AcquisitionState",
      "type": "object"
    },
    "AttemptRecord": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "compute_outcome": {
          "anyOf": [
            {
              "enum": [
                "not_started",
                "running",
                "completed",
                "completed_with_failures",
                "failed",
                "cancelled",
                "interrupted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compute Outcome"
        },
        "device": {
          "default": "",
          "title": "Device",
          "type": "string"
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "host": {
          "default": "",
          "title": "Host",
          "type": "string"
        },
        "job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "publication_outcome": {
          "anyOf": [
            {
              "enum": [
                "not_published",
                "verified_partial",
                "verified_complete",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Outcome"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "started_at"
      ],
      "title": "AttemptRecord",
      "type": "object"
    }
  },
  "$id": "https://cellquant.local/hpc/v1/result_index.schema.json",
  "additionalProperties": false,
  "description": "Every planned acquisition and its state. ``results.json`` in the durable run folder.",
  "properties": {
    "acquisitions": {
      "items": {
        "$ref": "#/$defs/AcquisitionState"
      },
      "title": "Acquisitions",
      "type": "array"
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/AttemptRecord"
      },
      "title": "Attempts",
      "type": "array"
    },
    "bundle_id": {
      "title": "Bundle Id",
      "type": "string"
    },
    "compute_outcome": {
      "default": "not_started",
      "enum": [
        "not_started",
        "running",
        "completed",
        "completed_with_failures",
        "failed",
        "cancelled",
        "interrupted"
      ],
      "title": "Compute Outcome",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "finalized": {
      "default": false,
      "title": "Finalized",
      "type": "boolean"
    },
    "publication_outcome": {
      "default": "not_published",
      "enum": [
        "not_published",
        "verified_partial",
        "verified_complete",
        "failed"
      ],
      "title": "Publication Outcome",
      "type": "string"
    },
    "ready_digest": {
      "title": "Ready Digest",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "ready_digest",
    "run_id",
    "created_at",
    "updated_at",
    "acquisitions"
  ],
  "title": "ResultIndex",
  "type": "object"
}
